# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
*.env

# Data directory (keep folder structure via .gitkeep, ignore large datasets)
data/*
!data/.gitkeep

# Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Model artifacts & temp outputs
models/*.pkl
models/*.joblib
models/*.onnx
!models/.gitkeep

# IDEs & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
